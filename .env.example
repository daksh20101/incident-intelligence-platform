# Copy this file to `.env` and edit it:   cp .env.example .env
# `.env` is listed in .gitignore, so your keys never reach GitHub.

ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------
# LLM settings. Every provider below speaks the OpenAI-compatible
# API, so switching provider = changing these four lines.
# ---------------------------------------------------------------

# Option A (default): Ollama on your own laptop. Free, private, no limits.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text

# Option B: Groq cloud free tier (no credit card). Key: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=paste-your-groq-key-here
# LLM_MODEL=openai/gpt-oss-120b

# Option C: Google Gemini free tier. Key: https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=paste-your-gemini-key-here
# LLM_MODEL=gemini-2.5-flash
